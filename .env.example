# ============================================================
# OCR Agent — Plantilla de Variables de Entorno
# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
# ============================================================

# --- Pipeline OCR ---
CONFIDENCE_THRESHOLD_PASS=0.80
CONFIDENCE_THRESHOLD_WARN=0.60
HANDWRITING_THRESHOLD=0.85
LAYOUT_COMPLEXITY_THRESHOLD=0.25

# --- Procesamiento ---
CELERY_CONCURRENCY=2
# 300 DPI: estándar de OCR, mejora el reconocimiento en documentos históricos
# degradados. 200 era el mínimo; subir a 300 sube la precisión real.
PDF_EXTRACTION_DPI=300
SURYA_BATCH_SIZE=8

# --- Modelos Ollama ---
# qwen2.5vl:32b (~21 GB): modelo de visión-lenguaje que hace TODO — OCR de
#   imágenes (impreso + manuscrito + tablas), corrección de texto, y resumen +
#   clasificación. Muy superior a minicpm-v en lectura de documentos. Cabe
#   holgado en una GPU de 32 GB (deja ~10 GB de margen) sin recargar modelos.
# Ambas variables apuntan al MISMO modelo a propósito (arquitectura unificada):
#   así Ollama mantiene un solo modelo cargado, sin swaps ni OOM.
# Alternativa para GPU chica (<24 GB): usar qwen2.5vl:7b (~6 GB) para visión
#   y qwen2.5:32b para corrección — dos modelos, algo menos de calidad.
OLLAMA_CORRECTION_MODEL=qwen2.5vl:32b
OLLAMA_VISION_MODEL=qwen2.5vl:32b

# --- AMD ROCm (GPU AMD para Ollama) ---
# Consultar version gfx con: rocminfo | grep gfx
# Ejemplos: RX 6000 serie -> 10.3.0 | RX 7000 serie -> 11.0.0 | RX 9000 serie -> 12.0.0
HSA_OVERRIDE_GFX_VERSION=11.0.0
ROCR_VISIBLE_DEVICES=0
# Nombre de la GPU para el dashboard (texto libre, opcional)
SYSTEM_GPU_NAME=

# --- Seguridad ---
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=cambiar-en-produccion-secret-key-aleatoria
